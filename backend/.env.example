# =============================================
# FLAVOUR POS - Environment Configuration
# =============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/flavour_pos

# JWT
JWT_SECRET=flavour_pos_super_secret_key_2024_change_in_production
JWT_EXPIRE=7d

# Twilio WhatsApp (get from twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Frontend URL
CLIENT_URL=http://localhost:5173

# Restaurant Info
RESTAURANT_NAME=FLAVOUR Restaurant
RESTAURANT_PHONE=+91XXXXXXXXXX
RESTAURANT_ADDRESS=Your Restaurant Address, City

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
